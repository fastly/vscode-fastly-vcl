{
  "name": "vscode-fastly-vcl",
  "displayName": "Fastly Varnish Configuration Language (VCL)",
  "description": "Fastly Varnish Configuration Language (VCL) language support for Visual Studio Code",
  "publisher": "fastly",
  "homepage": "https://github.com/fastly/vscode-fastly-vcl",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/fastly/vscode-fastly-vcl.git"
  },
  "version": "4.0.1",
  "engines": {
    "vscode": "^1.82.0",
    "node": ">=22"
  },
  "activationEvents": [],
  "browser": "./client/dist/extension.js",
  "workspaces": [
    "./client",
    "./server"
  ],
  "scripts": {
    "build": "tsc -b ./client && tsc -b ./server && tsc -p ./server/src/test && node scripts/bundle.mjs",
    "clean": "rm -rf client/out server/out client/dist server/dist",
    "dagger:ci": "DAGGER_NO_NAG=1 dagger call ci --source=.",
    "dagger:lint": "DAGGER_NO_NAG=1 dagger call lint --source=.",
    "dagger:test": "DAGGER_NO_NAG=1 dagger call test --source=.",
    "dagger:test-web": "DAGGER_NO_NAG=1 dagger call test-web --source=.",
    "dev": "tsc -b -w ./client ./server & node scripts/bundle.mjs --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ./client/src --ext .ts,.tsx",
    "package": "vsce package",
    "prebuild": "npm run clean",
    "prepackage": "npm run build && npm run lint",
    "pretest:e2e": "npm run build",
    "pretest:e2e:web": "npm run build",
    "publish": "vsce package",
    "test:colorization": "node ./test/runTest.mjs",
    "test:semantic-tokens": "node ./test/semanticTokens.test.js",
    "test:falco": "node --test --test-timeout=60000 test/falcoRecovery.test.mjs test/falcoComponentUrl.test.mjs",
    "test:selection-ranges": "npx tsx server/src/test/checkSelectionRanges.ts",
    "test:unit": "tsx --test --test-timeout=10000 server/src/test/*.test.ts",
    "test:e2e": "sh ./scripts/e2e.sh",
    "test:e2e:web": "vscode-test-web --browserType=${BROWSER:-chromium} --headless --quality=stable --extensionDevelopmentPath=. --extensionTestsPath=client/dist/test/index.js client/testFixture",
    "test": "npm run test:unit && npm run test:colorization && npm run test:semantic-tokens && npm run test:falco && npm run test:selection-ranges && npm run test:e2e",
    "vscode:prepublish": "npm run build && npm run lint && npm run test"
  },
  "categories": [
    "Programming Languages",
    "Language Packs"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vcl",
        "aliases": [
          "Fastly VCL",
          "vcl"
        ],
        "extensions": [
          ".vcl",
          ".VCL"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vcl",
        "scopeName": "source.vcl",
        "path": "./syntaxes/vcl.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Fastly VCL",
      "properties": {
        "fastly.vcl.lintingEnabled": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Enable linting."
        },
        "fastly.vcl.maxLintingIssues": {
          "scope": "resource",
          "type": "number",
          "default": 100,
          "description": "Specifies the maximum number of linting issues that the server will return."
        },
        "fastly.vcl.inlayHintsEnabled": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Enable inlay hints showing variable types."
        },
        "fastly.vcl.formattingEnabled": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Enable document formatting using falco fmt."
        }
      }
    }
  },
  "devDependencies": {
    "@bytecodealliance/preview2-shim": "^0.19.0",
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.82.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^4.0.0",
    "assert": "^2.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.15"
  }
}
