{
	"compilerOptions": {
		"target": "es2020",
		"lib": ["es2022", "webworker"],
		"module": "commonjs",
		"moduleResolution": "node",
		"ignoreDeprecations": "6.0",
		"strict": true,
		"noEmit": true,
		"rootDir": "src",
		"esModuleInterop": true,
		"resolveJsonModule": true
	},
	"include": ["src", "src/**/*.json"],
	"exclude": ["node_modules", ".vscode-test", "src/test"]
}
