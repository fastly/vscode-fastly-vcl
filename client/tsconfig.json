{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2020",
		"lib": ["es2020", "dom"],
		"outDir": "out",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["vscode", "mocha", "node"]
	},
	"include": ["src"],
	"exclude": ["node_modules", ".vscode-test"]
}
